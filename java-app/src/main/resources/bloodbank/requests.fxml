<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bloodbank.controller.RequestController"
            style="-fx-background-color: #f5f7fa;">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: #17212b;">
            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>
            <Label text="BLOOD BANK"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="| EMERGENCY REQUESTS"
                   style="-fx-text-fill: #aeb8c2; -fx-font-size: 14px;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#goToDashboard"
                    style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="22" right="25" bottom="22" left="25"/>
            </padding>

            <Label text="Emergency Blood Requests"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #17212b;"/>

            <Label text="Create requests and manage emergency blood requirements."
                   style="-fx-text-fill: #64748b;"/>

            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label text="Create Request"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Hospital ID"/>
                        <TextField fx:id="hospitalIdField" promptText="Hospital ID"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Blood Group"/>
                        <ComboBox fx:id="bloodTypeBox" promptText="Select blood group" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Component"/>
                        <ComboBox fx:id="componentBox" promptText="Select component" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Units Required"/>
                        <TextField fx:id="unitsRequestedField" promptText="Number of units"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Urgency"/>
                        <ComboBox fx:id="urgencyBox" promptText="Select urgency" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Status"/>
                        <ComboBox fx:id="statusBox" promptText="Select status" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button text="Create Request" onAction="#addRequest"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/>
                    <Button text="Allocate Blood" onAction="#allocateUnits"
                            style="-fx-background-color: #e65100; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Find Matches" onAction="#findMatches"
                            style="-fx-background-color: #6a1b9a; -fx-text-fill: white;"/>
                    <Button text="Update Status" onAction="#updateRequestStatus"
                            style="-fx-background-color: #1565c0; -fx-text-fill: white;"/>
                    <Button text="Delete Selected" onAction="#deleteRequest"
                            style="-fx-background-color: #c62828; -fx-text-fill: white;"/>
                    <Button text="Clear Form" onAction="#clearForm"/>
                </HBox>
            </VBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="All Requests"
                       style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField"
                           promptText="Search requests..."
                           onAction="#searchRequests"
                           prefWidth="280"/>
                <Button text="Search" onAction="#searchRequests"/>
                <Button text="Refresh" onAction="#loadRequests"/>
            </HBox>

            <TableView fx:id="requestTable" VBox.vgrow="ALWAYS"
                      >
                <columns>
                    <TableColumn fx:id="idColumn" text="Request ID" prefWidth="85"/>
                    <TableColumn fx:id="hospitalColumn" text="Hospital ID" prefWidth="85"/>
                    <TableColumn fx:id="bloodTypeColumn" text="Blood Group" prefWidth="100"/>
                    <TableColumn fx:id="componentColumn" text="Component" prefWidth="150"/>
                    <TableColumn fx:id="unitsColumn" text="Units" prefWidth="60"/>
                    <TableColumn fx:id="urgencyColumn" text="Urgency" prefWidth="90"/>
                    <TableColumn fx:id="dateColumn" text="Request Date" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="No requests available."/>
                </placeholder>
            </TableView>

            <Label text="Select a request before updating its status or deleting it."
                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        </VBox>
    </center>
</BorderPane>
