<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bloodbank.controller.DonorController">

    <!-- HEADER -->
    <top>
        <HBox spacing="20"
              style="-fx-background-color: #172033; -fx-padding: 18;">

            <Label text="BLOOD BANK | DONOR MANAGEMENT"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS"/>

            <Button text="Dashboard"
                    onAction="#goToDashboard"
                    style="-fx-background-color: #2f3b52; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>


            <!-- TITLE -->
            <Label text="Donor Management"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>


            <!-- FORM -->
            <GridPane hgap="15"
                      vgap="12"
                      style="-fx-background-color: #f4f6f8; -fx-padding: 18;">

                <!-- First Name -->
                <Label text="First Name:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="firstNameField"
                           promptText="Enter first name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>


                <!-- Last Name -->
                <Label text="Last Name:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="lastNameField"
                           promptText="Enter last name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="3"/>


                <!-- Blood Type -->
                <Label text="Blood Type:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="bloodTypeBox"
                          promptText="Select blood type"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>


                <!-- DOB -->
                <Label text="Date of Birth:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

                <DatePicker fx:id="dobPicker"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="3"/>


                <!-- Gender -->
                <Label text="Gender:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="genderBox"
                          promptText="Select gender"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>


                <!-- Contact -->
                <Label text="Contact Number:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="contactNumberField"
                           promptText="Enter phone number"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="3"/>


                <!-- Email -->
                <Label text="Email:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           promptText="Enter email"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>


                <!-- Address -->
                <Label text="Address:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="addressField"
                           promptText="Enter address"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="3"/>


                <!-- Last Donation -->
                <Label text="Last Donation:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="lastDonationPicker"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"/>


                <!-- Eligibility -->
                <Label text="Eligibility Status:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="2"/>

                <ComboBox fx:id="eligibilityStatusBox"
                          promptText="Select status"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="3"/>

            </GridPane>


            <!-- BUTTONS -->
            <HBox spacing="10">

                <Button text="Add Donor"
                        onAction="#addDonor"
                        style="-fx-background-color: #198754; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Update Donor"
                        onAction="#updateDonor"
                        style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Delete Donor"
                        onAction="#deleteDonor"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Clear"
                        onAction="#clearForm"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;"/>

            </HBox>


            <!-- SEARCH -->
            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Search by name, blood type, address or contact..."
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#searchDonors"/>

                <Button text="Show All"
                        onAction="#loadDonors"/>

            </HBox>


            <!-- TABLE -->
            <TableView fx:id="donorTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="firstNameColumn"
                                 text="First Name"
                                 prefWidth="120"/>

                    <TableColumn fx:id="lastNameColumn"
                                 text="Last Name"
                                 prefWidth="120"/>

                    <TableColumn fx:id="bloodTypeColumn"
                                 text="Blood Type"
                                 prefWidth="90"/>

                    <TableColumn fx:id="dobColumn"
                                 text="DOB"
                                 prefWidth="100"/>

                    <TableColumn fx:id="genderColumn"
                                 text="Gender"
                                 prefWidth="80"/>

                    <TableColumn fx:id="contactColumn"
                                 text="Contact"
                                 prefWidth="130"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="180"/>

                    <TableColumn fx:id="addressColumn"
                                 text="Address"
                                 prefWidth="180"/>

                    <TableColumn fx:id="lastDonationColumn"
                                 text="Last Donation"
                                 prefWidth="110"/>

                    <TableColumn fx:id="eligibilityColumn"
                                 text="Eligibility"
                                 prefWidth="140"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>